{
  "formTitle": "Promotion Rule Name Generator",
  "titleTemplate": "SEHK_{Site}_{Type}_{Series}_{discountMechanism}_{startDate}_{promoSite}",
  "fields": [
    {
      "id": "Site",
      "label": "Site",
      "type": "select",
      "required": true,
      "options": [
        { "label": "B2C", "value": "B2C" },
        { "label": "B2B", "value": "B2B" }
      ]
    },
    {
      "id": "Category",
      "label": "Category",
      "type": "select",
      "required": true,
      "options": [
        { "label": "MX", "value": "MX" },
        { "label": "CE", "value": "CE" }
      ]
    },
    {
      "id": "Type",
      "label": "Type",
      "type": "select",
      "required": true,
      "options": [
        { "label": "Mass", "value": "Mass" },
        { "label": "CRM", "value": "CRM" },
        { "label": "CRP", "value": "CRP" },
        { "label": "ePromoter", "value": "ePromoter" },
        { "label": "Others", "value": "Others" }
      ]
    },
    {
      "id": "typeOthers",
      "label": "Type Details",
      "type": "text",
      "placeholder": "e.g. VIP",
      "required": false,
      "dependsOn": {
        "field": "Type",
        "value": "Others"
      }
    },
    {
      "id": "Series",
      "label": "Series",
      "type": "text",
      "placeholder": "e.g. S26",
      "required": false
    },
    {
      "id": "discountMechanism",
      "label": "Discount Mechanism",
      "type": "select",
      "required": true,
      "options": [
        { "label": "Discount", "value": "Discount" },
        { "label": "Bundle", "value": "Bundle" },
        { "label": "Target Fixed Price", "value": "Target Fixed Price" }
      ]
    },
    {
      "id": "startDate",
      "label": "Month",
      "type": "month",
      "required": true
    },
    {
      "id": "promoSite",
      "label": "Promotion Site",
      "type": "select",
      "required": true,
      "options": [
        { "label": "B2C", "value": "B2C" },
        { "label": "EA", "value": "EA" },
        { "label": "EPP", "value": "EPP" },
        { "label": "EDU", "value": "EDU" }
      ]
    }
  ]
}
